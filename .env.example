# Copy to secrets.env and fill in real values. secrets.env is git-ignored.

# --- Spotify API (used by spotipy for playlist ingestion / metadata) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:9090
SPOTIFY_SCOPE=user-library-read, playlist-read-private, playlist-modify-public

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=db

# --- spodown download API ---
SPODOWN_API_KEY_1=
SPODOWN_API_KEY_2=
SPODOWN_API_KEY_3=
SPODOWN_API_BASE_URL=https://hunt.spodown.com/api/v1/ext
DOWNLOAD_FORMAT=mp3-320

# --- Worker tuning ---
DOWNLOADS_FOLDER=/mnt/spotify-dl
MAX_DOWNLOADS_PER_KEY=2
POLL_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_BACKOFF_SECONDS=120
LOG_LEVEL=INFO

# --- Optional: playlist used by `add-missing-to-playlist` ---
MISSING_TRACKS_PLAYLIST_ID=
